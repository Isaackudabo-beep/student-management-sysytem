{
  "name": "student-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Student Management System",
  "scripts": {
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm run dev --prefix web",
    "build": "npm install --prefix api --include=dev && npm run build --prefix api",
    "build:api": "npm run build --prefix api",
    "build:web": "npm run build --prefix web",
    "start": "npm run start:render --prefix api",
    "start:render": "npm run start:render --prefix api",
    "db:migrate": "npm run db:migrate --prefix api",
    "db:seed": "npm run db:seed --prefix api",
    "db:studio": "npm run db:studio --prefix api"
  },
  "engines": {
    "node": ">=20"
  }
}
