// Purpose: Prisma schema — secondary school SMS domain model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  TEACHERS
  ADMINS
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  passwordHash       String
  role               Role
  mustChangePassword Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  student            Student?
  teacher            Teacher?
  resetTokens        PasswordResetToken[]
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[]
}

model SchoolClass {
  id        String    @id @default(cuid())
  name      String    @unique
  level     String
  arm       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@index([level])
}

model Student {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber  String       @unique
  matricNumber     String       @unique
  firstName        String
  lastName         String
  email            String       @unique
  phone            String
  gender           Gender
  dateOfBirth      DateTime
  address          String
  parentName       String
  parentPhone      String
  department       String       @default("General")
  level            String
  classId          String
  schoolClass      SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  enrollments      Enrollment[]

  @@index([classId])
  @@index([level])
}

model Teacher {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String           @unique
  phone      String?
  department String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  subjects   TeacherSubject[]
  scores     Score[]
}

model Subject {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  unit        Int
  semester    Int
  level       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  teachers    TeacherSubject[]
  enrollments Enrollment[]

  @@index([level])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  session   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, session])
  @@index([subjectId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  session   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  score     Score?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, session])
  @@index([subjectId])
}

model Score {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  teacherId    String
  assessment   Float
  exam         Float
  total        Float
  grade        String
  remark       String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([teacherId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience
  createdById String
  createdBy   User                 @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  publishedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  reads       AnnouncementRead[]

  @@index([audience])
  @@index([publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([userId, announcementId])
}
