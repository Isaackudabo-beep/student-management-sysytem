// Purpose: Prisma schema — multi-school SMS domain model.
generator client {
  provider      = "prisma-client-js"
  // native = local; debian = Render Linux free/starter images
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Term {
  FIRST
  SECOND
  THIRD
}

enum AcademicStatus {
  ACTIVE
  PROMOTED
  REPEATING
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  TEACHERS
  ADMINS
  CLASS
  USER
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

/// Platform tenant — each school is an isolated workspace.
model School {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  address     String?
  phone       String?
  email       String?
  status      SchoolStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  classes     SchoolClass[]
  students    Student[]
  teachers    Teacher[]
  subjects    Subject[]
  announcements Announcement[]

  @@index([status])
  @@index([name])
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  passwordHash       String
  role               Role
  /// Null only for SUPER_ADMIN (platform-level). Required for school roles.
  schoolId           String?
  school             School?             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  mustChangePassword Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  student            Student?
  teacher            Teacher?
  resetTokens        PasswordResetToken[]
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[]
  targetedAnnouncements Announcement[]  @relation("AnnouncementTargetUser")

  @@index([schoolId])
  @@index([role])
}

model SchoolClass {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name          String
  level         String
  arm           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  students      Student[]
  announcements Announcement[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([level])
}

model Student {
  id               String         @id @default(cuid())
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber  String
  matricNumber     String
  firstName        String
  lastName         String
  email            String
  phone            String
  gender           Gender
  dateOfBirth      DateTime
  address          String
  parentName       String
  parentPhone      String
  department       String         @default("General")
  level            String
  classId          String
  schoolClass      SchoolClass    @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicStatus   AcademicStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enrollments      Enrollment[]
  archivedResults  ResultArchive[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, matricNumber])
  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([classId])
  @@index([level])
  @@index([academicStatus])
}

model Teacher {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String?
  department String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  subjects   TeacherSubject[]
  scores     Score[]

  @@unique([schoolId, email])
  @@index([schoolId])
}

model Subject {
  id          String           @id @default(cuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  code        String
  title       String
  unit        Int
  semester    Int
  level       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  teachers    TeacherSubject[]
  enrollments Enrollment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([level])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  session   String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, session])
  @@index([subjectId])
  @@index([session])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  session   String
  term      Term     @default(FIRST)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  score     Score?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, session, term])
  @@index([subjectId])
  @@index([session, term])
}

model Score {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  teacherId    String
  assessment   Float
  exam         Float
  total        Float
  grade        String
  remark       String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([teacherId])
}

/// Snapshot of scores cleared when a term is closed (students/teachers/classes kept).
model ResultArchive {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session         String
  term            Term
  subjectCode     String
  subjectTitle    String
  className       String
  level           String
  assessment      Float
  exam            Float
  total           Float
  grade           String
  remark          String
  teacherName     String?
  archivedAt      DateTime @default(now())

  @@index([studentId])
  @@index([session, term])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Announcement {
  id            String               @id @default(cuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  title         String
  body          String
  audience      AnnouncementAudience
  createdById   String
  createdBy     User                 @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  targetClassId String?
  targetClass   SchoolClass?         @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?                @relation("AnnouncementTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  expiresAt     DateTime?
  publishedAt   DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  reads         AnnouncementRead[]

  @@index([schoolId])
  @@index([audience])
  @@index([publishedAt])
  @@index([targetClassId])
  @@index([targetUserId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([userId, announcementId])
}
