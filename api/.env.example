# Purpose: Environment template for the API. Copy to .env and fill in real values.
# Never commit .env — it contains secrets.

# App runtime (use Neon pooler host when using Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_db?schema=public"
# Prisma migrations (use Neon direct host when using Neon — no -pooler suffix)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sms_db?schema=public"

JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
